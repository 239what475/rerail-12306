name: rerail-entry

services:
  gateway:
    image: {{ acr_address }}/12306-gateway:latest
    container_name: rerail-gateway
    network_mode: host
    restart: unless-stopped
    environment:
      # 载体默认 profile 是 aggregation（路由指向聚合服务），必须切到 dev 才路由到各微服务
      SPRING_PROFILES_ACTIVE: dev
      SPRING_CLOUD_NACOS_DISCOVERY_SERVER_ADDR: {{ mw_ip }}:8848
      SPRING_DATA_REDIS_HOST: {{ mw_ip }}
      SPRING_DATA_REDIS_PORT: "6379"
      SPRING_DATA_REDIS_PASSWORD: "{{ redis_password }}"
      OTEL_SERVICE_NAME: rerail-gateway
      OTEL_TRACES_EXPORTER: zipkin
      OTEL_METRICS_EXPORTER: prometheus
      OTEL_EXPORTER_PROMETHEUS_HOST: "0.0.0.0"
      OTEL_EXPORTER_PROMETHEUS_PORT: "9464"
      OTEL_LOGS_EXPORTER: "none"
      OTEL_EXPORTER_ZIPKIN_ENDPOINT: http://{{ builder_ip }}:9411/api/v2/spans
      OTEL_TRACES_SAMPLER: parentbased_traceidratio
      OTEL_TRACES_SAMPLER_ARG: "{{ otel_sampling_ratio }}"
      JAVA_OPTS: -Dotel.instrumentation.http.default-bucket-boundaries=[0.005,0.01,0.025,0.05,0.1,0.25,0.5,1,2.5,5,10] -Dfile.encoding=UTF-8 -javaagent:/otel/opentelemetry-javaagent.jar -Xms256m -Xmx512m
    volumes:
      - ../../otel:/otel:ro
    logging: { driver: json-file, options: { max-size: "50m", max-file: "3" } }

  nginx:
    image: {{ acr_address }}/12306-nginx:1.25-alpine
    container_name: rerail-nginx
    network_mode: host
    restart: unless-stopped
    depends_on:
      - gateway
    volumes:
      - ../config/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    logging: { driver: json-file, options: { max-size: "50m", max-file: "3" } }
